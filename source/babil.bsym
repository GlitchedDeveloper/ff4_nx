enum enAchievementCheckTimings u32 {
    Always: 0;
    EventStart: .0;
    EventFinish: .1;
    PlayNewGame: .2;
    FreeMove: .3;
    FreeVehicle: .4;
    BattleEnd: .5;
    Reported: .6;
    UseAbilityItem: .7;
    ShopSell: .8;
}

enum enAchievementCheckTypes u32 {
    Flag: 0;
    FlagRange: 1;
    HardModeBeat: 2;
    BeatCount: 3;
    GetItem: 4;
    GetDecant: 5;
    GetDecantCnt: 6;
    LearnSummon: 7;
    LearnSummonCnt: 8;
    CompletedMap: 9;
    OverPlayerLevel: 10;
    Gill: 11;
    MonsterKillCount: 12;
    MonsterDictionary: 13;
    MonsterPartyKill: 14;
    NoCheck: 15;
    Field: 16;
    AchievementComp: 17;
}

// Per-monster bestiary entry (2 bytes). kill() caps m_KillCount at 999 and clears
// bits 14..15 via `& 0x3fff`.
bit MonsterMania u16 {
    0    : bool Encountered;
    1    : bool EncounteredAlt;
    2    : bool InLibrary;
    3    : bool unk;
    4-13 : u16 KillCount;
}

