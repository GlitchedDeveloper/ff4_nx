    PlayerParty {
        // Holds 15 inline Players (stride 0x230 from +0x50), a PlayerSummon, a
        // CurrentAbilityIDList, save/active-member pointer pairs, chain-loaded lookup
        // tables, and 5 BattleCommands. Sub-objects with unknown layouts are raw byte
        // arrays so the static_asserts below stay verifiable.
        0x0    : Player*[5] SaveComposition;
        // active party, indexed 0..4 by "order"
        0x28   : Player*[5] Members;
        // 15 inline Players;
        // m_Id offsets: 0x15c, 0x38c, 0x5bc, 0x7ec,
        // 0xa1c, 0xc4c, 0xe7c, 0x10ac, 0x12dc, 0x150c,
        // 0x173c, 0x196c, 0x1b9c, 0x1dcc, 0x1ffc
        0x50   : Player[15] Players;
        0x2120 : u8[0x28] PlayerSummon;
        0x2148 : u8[0x98] CurrentAbilityIDList;
        // owned, freed by free()
        0x21e0 : void* RawChainData;
        // chain 0 (unused by dumped funcs)
        0x21e8 : void* LearnChain0;
        // chain 1, stride 0x14
        0x21f0 : void* NormalAttack;
        // chain 0x20, stride 0x20
        0x21f8 : void* NormalMagic;
        0x2200 : s16 NormalMagicCount;
        // chains 2..0x10, per PLAYER_TYPES
        0x2208 : void*[15] LearnAbilityData;
        // chain 0x21, stride 8, 0xe68 bytes
        0x2280 : void* AbilityList;
        // chain 0x22, stride 0x6c
        0x2288 : void* LayoutSceneParameter;
        0x2290 : s32 LayoutSceneParameterCount;
        // chain 0x23, stride 0x30
        0x2298 : void* WeaponOffsetParameter;
        // chains 0x11..0x1f, per PLAYER_TYPES
        0x22a0 : void*[15] LearnAbilityLookup;
        0x2318 : s16[15] LearnAbilityCount;
        // ceil(rawSize/0x14)
        0x2338 : u32 NormalAttackCount;
        // chain 0x24, stride 0xa
        0x2340 : void* AbilityBounsTable;
        // ceil(rawSize/0xa)
        0x2348 : u32 AbilityBounsCount;
        0x234c : BattleCommand[5] BattleCommands;

        s16* abilityBouns(this, common::ABILITY_ID abilityId); -> _ZN2pl11PlayerParty12abilityBounsEN6common10ABILITY_IDE
        void* abilityList(this, s32 id); -> _ZN2pl11PlayerParty11abilityListEi
