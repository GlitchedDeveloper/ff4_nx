common {
    enum ABILITY_ID s8 {}

    struct BabilMagicParameter {}

    // Effect-data table loaded from "efficacy.beld.lz". Built as 127 hash buckets
    // (indexed by effectId & 0x7f), each a singly-linked list of HashNode entries
    // chained through HashNode::m_Next. m_Status: bit 0 = initialized, bit 1 = .beld loaded.
    EfficacyDataConvection {
        // 0x00 - bit 0: initialized; bit 1: .beld loaded
        0x00 : u16 Status;
        // 0x08 - owned (ds::CHeap::alloc_app / free_app)
        0x08 : void* RawData;
        // 0x10 - owned (malloc_count); array of 0x10-byte nodes
        0x10 : HashNode* EffectData;
        // 0x18 - owned (malloc_count); 127-entry bucket head array
        0x18 : HashNode** HashTable;

        void Ctor(this); -> _ZN6common22EfficacyDataConvectionC2Ev
        // empty; real cleanup is in terminate()
        void Dtor(this); -> _ZN6common22EfficacyDataConvectionD2Ev
        // ignores self; reads global instance_
        s32* getEfficacyData(this, s32 effectId); -> _ZN6common22EfficacyDataConvection15getEfficacyDataEi
        // m_Status |= 1
        void initialize(this); -> _ZN6common22EfficacyDataConvection10initializeEv
        // panics on bad magic ('BELD' = 0x444c4542) or wrong state
        void loadBELD(this); -> _ZN6common22EfficacyDataConvection8loadBELDEv
        // unloadBELD + clears m_Status
        void terminate(this); -> _ZN6common22EfficacyDataConvection9terminateEv
        // frees m_HashTable, m_EffectData, m_RawData; leaves m_Status
        void unloadBELD(this); -> _ZN6common22EfficacyDataConvection10unloadBELDEv

        this instance_; -> _ZN6common22EfficacyDataConvection9instance_E

        // 16-byte hash-chain node stored in m_EffectData. m_Data points into m_RawData
        // at an EffectData record whose first 4 bytes are s32 m_EffectId; the rest of
        // that record is type-specific (parsed at load time from per-type cumulative
        // offsets in the BELD header).
        HashNode[0x10] {
            // -> EffectData record in m_RawData
            0x0 : void* Data;
            // next node in bucket, or NULL
            0x8 : void* Next;
        }
    }
}

