{
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/build_nx": false,
        "**/build_pc": true,
        "android-project": true,
        "ps4": true,
        "psv": true,
        "winrt": true,
        "library/cmake": true,
        "library/lib/extern": true,
        "resources": true,
        "demo": true
    },
    "search.exclude": {
        "**/.git": true,
        "**/build_nx": true,
        "**/build_pc": true,
        "android-project": true,
        "ps4": true,
        "psv": true,
        "winrt": true,
        "library/cmake": true,
        "library/lib/extern": true,
        "resources": false
    },
    "editor.formatOnPaste": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    
    "xml.validation.enabled": false,

    "clangd.arguments": [
        "--compile-commands-dir=build_nx",
        "--query-driver=C:/devkitPro/devkitA64/bin/*",
        "--header-insertion=iwyu"
    ],

    "C_Cpp.intelliSenseEngine": "disabled"
}