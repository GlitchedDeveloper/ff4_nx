ui {
    CWidgetMng g_WidgetMng; -> _ZN2ui11g_WidgetMngE

    CWidgetMng {
        // hash table of widget chains, bucket = id & 0x3f
        0x000 : Widget*[0x40] WidgetTable;
        // source data ptr for type-4 sprite widgets (addWidget); cleared in init/terminate
        0x200 : void* field_0x200;
        // source data ptr for type-5/6 sprite widgets (addWidget); cleared in init/terminate
        0x208 : void* field_0x208;
        // widget id currently selected/pressed (confirmed against the
        // raw disassembly; Ghidra's pseudocode mislabels this field).
        0x210 : s32 SelectedElement;
        // scratch state shared by moveWidget (previous-frame hover id)
        // and moveSlide (next slide-state value); same 4 bytes, two uses.
        0x214 : s32 field_0x214;
        // write-only from these 31 functions; mirrors m_SelectedElement
        // whenever it changes, presumably read by code outside CWidgetMng.
        0x218 : s32 FocusedElement;
        // write-only from these 31 functions; same mirroring as field_0x218.
        0x21c : s32 field_0x21c;
        // frame counter for press-and-hold on m_SelectedElement
        0x220 : s32 SelectedHoldFrames;
        // touch-anchor widget id snapshot
        0x224 : u32 field_0x224;
        // previous touch x
        0x228 : s16 field_0x228;
        // previous touch y
        0x22a : s16 field_0x22a;
        // touch-down x
        0x22c : s16 field_0x22c;
        // touch-down y
        0x22e : s16 field_0x22e;
        // touch panel was down last frame
        0x230 : bool WasTouching;
        // set via setDragState
        0x231 : bool DragState;
        // moveSlide() state machine state
        0x234 : s32 SlideState;
        // current slide offset (signed, animates back to 0)
        0x238 : s32 SlideOffset;
        // +1/-1 direction multiplier for the active slide
        0x23c : s32 SlideDirection;
        // x passed to NNS_G2dSetSlide, set by setSlide
        0x240 : s32 SlideX;
        // y passed to NNS_G2dSetSlide, set by setSlide
        0x244 : s32 SlideY;
        // touch x sampled when the slide drag began
        0x248 : s16 TouchAnchorX;
        // touch y sampled when the slide drag began
        0x24a : s16 TouchAnchorY;
        // current scroll offset, set by setScroll(Pos/Rect)
        0x24c : s32 ScrollPos;
        // max scrollable extent (setScroll param_3 / setScrollRect param_5)
        0x250 : s32 ScrollMax;
        // x passed to NNS_G2dSetScroll
        0x254 : s32 ScrollX;
        // y passed to NNS_G2dSetScroll
        0x258 : s32 ScrollY;
        // extra scroll-rect width, only set by setScrollRect
        0x25c : s32 field_0x25c;
        // viewport height, set by setScroll(param_2)/setScrollRect(param_4)
        0x260 : s32 ScrollHeight;
        // scroll/select animation inertia value
        0x264 : float ScrollVelocity;
        // indexed directly by cursor id (1..6); slot 0 is unused padding,
        // so the array really spans ids 0..6 and id 6's slot is the same
        // 4 bytes as m_ListMax[0] below (harmless aliasing in the original).
        0x268 : s32[6] CursorItem;
        // set/read via setListMax/getListMax; m_ListMax[0] aliases the
        // cursor-id-6 slot above (same bytes, reused by the original code)
        0x280 : s32[2] ListMax;
        // gates the pad-driven selection shortcut in moveWidget
        0x288 : bool PadCheckEnable;
        // pad bitmask checked (with 0x10000) to jump to active cursor item
        0x28c : u32 PadMaskSelect;
        // pad bitmask checked for the "no selection yet" shortcut
        0x290 : u32 PadMaskCancel;
        // per-frame pad callback, default set by setDefaultPadKeyFunc
        0x298 : uptr PadKeyFunc;
        // argument passed to m_PadKeyFunc
        0x2a0 : s32 PadKeyFuncArg;

        // type (flags & 0xff): 1=line-list row, 2=scrollbar-list row, 3=window (BasicWindow), 4/5/6=sprite
        // (cell anim) widgets, 7/8/9/10=plain rects of increasing NNS_G2dAddWidget style index.
        void addWidget(this, s32 id, s32 x, s32 y, s32 width, s32 height, s32 text_color, s32 msd, u32 flags); -> _ZN2ui10CWidgetMng9addWidgetEiiiiiiii
        void cleanWidget(this); -> _ZN2ui10CWidgetMng11cleanWidgetEv
        void DefaultPadKeyFunc(this, s32 padMask, bool playSE); -> _ZN2ui10CWidgetMng17DefaultPadKeyFuncEib
        // -> DefaultPadKeyFunc_LineMulti(.., 2, ..)
        void DefaultPadKeyFunc_Line2(this, s32 padMask, bool playSE); -> _ZN2ui10CWidgetMng23DefaultPadKeyFunc_Line2Eib
        // -> DefaultPadKeyFunc_LineMulti(.., 3, ..)
        void DefaultPadKeyFunc_Line3(this, s32 padMask, bool playSE); -> _ZN2ui10CWidgetMng23DefaultPadKeyFunc_Line3Eib
        void DefaultPadKeyFunc_LineMulti(this, s32 padMask, s32 lineWidth, bool playSE); -> _ZN2ui10CWidgetMng27DefaultPadKeyFunc_LineMultiEiib
        void deleteWidget(this, Widget* widget); -> _ZN2ui10CWidgetMng12deleteWidgetEPNS_6WidgetE
        // count==1: delete single id; else delete [id, id+count) range
        void deleteWidgetRange(this, s32 id, s32 count); -> _ZN2ui10CWidgetMng12deleteWidgetEii
        // thunk -> drawWidget() on the global g_WidgetMng instance
        void draw(); -> _ZN2ui10CWidgetMng4drawEv
        void drawWidget(this); -> _ZN2ui10CWidgetMng10drawWidgetEv
        // moveWidget() + moveSlide()
        void execute(this); -> _ZN2ui10CWidgetMng7executeEv
        // lookup only; result discarded by the original (likely dead code)
        void findWidget(this, s32 id); -> _ZN2ui10CWidgetMng10findWidgetEi
        // first of cursors 1..6 whose widget isn't flagged 0x4
        s32 getActiveCursor(this); -> _ZN2ui10CWidgetMng15getActiveCursorEv
        // m_CursorItem[getActiveCursor()]
        s32 getActiveCursorItem(this); -> _ZN2ui10CWidgetMng19getActiveCursorItemEv
        // m_ListMax[0 or 1] for the active cursor's item bucket
        s32 getActiveCursorListMax(this); -> _ZN2ui10CWidgetMng22getActiveCursorListMaxEv
        s32 getCursorItem(this, s32 cursor); -> _ZN2ui10CWidgetMng13getCursorItemEi
        // index < 2
        s32 getListMax(this, s32 index); -> _ZN2ui10CWidgetMng10getListMaxEi
        void initialize(this); -> _ZN2ui10CWidgetMng10initializeEv
        void moveSlide(this); -> _ZN2ui10CWidgetMng9moveSlideEv
        void moveWidget(this); -> _ZN2ui10CWidgetMng10moveWidgetEv
        void setCursor(this, s32 newWidgetId, s32 anchorWidgetId, s32 msd, u32 flags, bool updateCursorTable); -> _ZN2ui10CWidgetMng9setCursorEiiiib
        void setDefaultPadKeyFunc(this); -> _ZN2ui10CWidgetMng20setDefaultPadKeyFuncEv
        void setDragState(this, bool dragging); -> _ZN2ui10CWidgetMng12setDragStateEb
        // index < 2
        void setListMax(this, s32 index, s32 max); -> _ZN2ui10CWidgetMng10setListMaxEii
        void setScroll(this, s32 y, s32 height, s32 max); -> _ZN2ui10CWidgetMng9setScrollEiii
        void setScrollPos(this, s32 pos); -> _ZN2ui10CWidgetMng12setScrollPosEi
        void setScrollRect(this, s32 x, s32 y, s32 width, s32 height, s32 max); -> _ZN2ui10CWidgetMng13setScrollRectEiiiii
        void setSlide(this, s32 x, s32 y); -> _ZN2ui10CWidgetMng8setSlideEii
        void setWidgetEnable(this, s32 idStart, s32 idCount, s8 enable); -> _ZN2ui10CWidgetMng15setWidgetEnableEiic
        void setWidgetHilight(this, s32 idStart, s32 idCount, s32 hilightId); -> _ZN2ui10CWidgetMng16setWidgetHilightEiii
        void terminate(this); -> _ZN2ui10CWidgetMng9terminateEv
    }

    // A single widget node, allocated individually (malloc_count(0x38)) and stored
    // in CWidgetMng::cls::m_WidgetTable as a singly-linked list, hashed by (id & 0x3f).
    Widget[0x38] {
        0x00 : u32 id;
        0x04 : s32 x;
        0x08 : s32 y;
        0x0c : s32 width;
        0x10 : s32 height;
        0x14 : s32 textColor;
        0x18 : s32 msd;
        // bit0..7: widget "type" (switch in drawWidget); 0x200: scroll-relative;
        // 0x400: alt size variant; 0x800: alt hilight style; 0x1000: disabled
        // (setWidgetEnable); 0x2000: hilighted/selected (setWidgetHilight);
        // 0x4000: dgs msd-name special case (addWidget)
        0x1c : u32 flags;
        // menu::BasicWindow*, only allocated for type 3 widgets
        0x20 : void* basicWindow;
        // sys2d::Sprite*/Sprite3d*, allocated for type 4/5/6 widgets
        0x28 : void* sprite;
        // next node in this bucket's chain
        0x30 : Widget* next;
    }
}

