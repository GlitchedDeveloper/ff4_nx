    void syncSaveData(this, AchievementResource* resource); -> _ZN19AchievementReporter12syncSaveDataEP19AchievementResource
    void update(this); -> _ZN19AchievementReporter6updateEv
}

// AchievementResource - holds the AchievementParam[] array. Helpers (getNum, etc.)
