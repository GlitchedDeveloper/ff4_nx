struct AchievementParam[0x140] {
    0x0  : c8[0x40] Identifier;
    0x40 : enAchievementCheckTimings Timing;
    0x44 : enAchievementCheckTypes Type;
    0x48 : {
        s32[0x3e] Data;
        AchievementFlagParam[20] FlagParam;
        AchievementFlagRangeParam[14] FlagRangeParam;
        AchievementHardModeBeatParam HardModeBeatParam;
        AchievementBeatCountParam BeatCountParam;
        AchievementGetItemParam[60] GetItemParam;
        AchievementGetDecantParam[60] GetDecantParam;
        AchievementGetDecantCntParam GetDecantCntParam;
        AchievementLearnSummonParam[30] LearnSummonParam;
        AchievementLearnSummonCntParam LearnSummonCntParam;
        AchievementCompletedMapParam CompletedMapParam;
        AchievementOverPlayerLevelParam[30] OverPlayerLevelParam;
        AchievementGillParam GillParam;
        AchievementMonsterKillCountParam MonsterKillCountParam;
        AchievementMonsterDictionaryParam MonsterDictionaryParam;
        AchievementMonsterPartyKillParam[60] MonsterPartyKillParam;
        AchievementNoCheckParam NoCheckParam;
        AchievementFieldParam FieldParam;
        AchievementCompParam AchievementCompParam;
    };
}

struct ReportEntry[0x10] {
    0x0 : u32 State;
    0x8 : AchievementParam* Param;
}

struct FuncEntry[0x10] {
    0x0 : void* funcPtr;
    0x8 : uptr flags;
}

// AchievementChecker - 0x18 bytes. Ghidra mislabels the fields; asm writes
// x1->[0x00], x2->[0x10], x3->[0x08].
AchievementChecker[0x18] {
    0x0  : AchievementReporter* AchievementReporter;
    0x8  : AchievementCheckFuncs* AchievementCheckFuncs;
    0x10 : AchievementResource* AchievementResource;

    void Ctor(this); -> _ZN18AchievementCheckerC1Ev
    void Dtor(this); -> _ZN18AchievementCheckerD1Ev
    void init(this, AchievementReporter* reporter, AchievementResource* resource, AchievementCheckFuncs* checkFuncs); -> _ZN18AchievementChecker4initEP19AchievementReporterP19AchievementResourceP21AchievementCheckFuncs
    void update(this, enAchievementCheckTimings timing); -> _ZN18AchievementChecker6updateE25enAchievementCheckTimings
}

// AchievementCheckFuncs - 0x138 bytes. m_Funcs[18] order: flag, flagRange,
// hardModeBeat, beatCount, getItem, getDecant, getDecantCnt, learnSummon,
// learnSummonCnt, completedMap, overPlayerLevel, gill, monsterKillCount,
// monsterDictionary, monsterKillParty, noCheck, field, achievementComp.
// FuncEntry.flags low bit = indirect (funcPtr is a vtable base, flags>>1 is offset).
AchievementCheckFuncs {
    0x0   : void* AchievementResource;
    0x8   : FuncEntry[18] Funcs;
