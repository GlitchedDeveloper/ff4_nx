    // 0x32-byte bit-flag storage backing LearningAbilityManager. Layout matches the
    // 6 m_Flags[i] pointers LearningAbilityManager stores (offsets 0x00, 0x20, 0x24,
    // 0x29, 0x2e, 0x30 with sizes 32/4/5/5/2/2). Each sub-array partitions the global
    // common::ABILITY_ID space:
    // [0]→0x000..0x5db  [1]→0x5dc..0xf9f  [2]→0xfa0..0x1193
    // [3]→0x1194..0x12bf  [4]→0x12c0..0x1323  [5]→0x1324..0x1333
    LearningAbilityManagerContents[0x32] {
        // 256 bits, includes the 5 magic-type ability bits
        0x00 : u8[0x20] FlagsType0;
        // 32  bits
        0x20 : u8[0x04] FlagsType1;
        // 40  bits
        0x24 : u8[0x05] FlagsType2;
        // 40  bits
        0x29 : u8[0x05] FlagsType3;
        // 16  bits
        0x2e : u8[0x02] FlagsType4;
        // 16  bits
        0x30 : u8[0x02] FlagsType5;
    }

    // Size 0x230 — confirmed by PlayerParty's 15-Player stride. Sub-object
    // offsets verified against the ctor and `equipmentAttach(HAND_TYPE) =
    // self + handType*0x1c + 0x1c8`.
    Player[0x230] {
        // slot active flag
        0x0   : u8 Enabled;
        // subobject; playerAbilityManager() returns &this
        0x8   : u8[0x104] PlayerAbilityManager;
        0x10c : PLAYER_TYPES PlayerType;
        0x110 : ys::BodyParameter BodyParameter;
        // PlayerEquipParameter; equipParameter() returns &this
        0x118 : u8[0x8] PlayerEquipParameter;
        // s16[5] of equipment ids
        0x120 : s16* EquipmentItems;
        // EquipmentMagicBinder subobject
        0x128 : u8[0x50] EquipmentMagicBinder;
        // subobject (setPhysicsAttack / updateParameter)
        0x178 : u8[0x2c] PhysicsAttackParam;
        // subobject (calcPhysicsDefense)
        0x1a4 : u8[0x12] PhysicsDefenseParam;
        // 5 clamped stat bytes (STR/AGI/VIT/LUCK/INT)
        0x1b6 : u8[5] Stats;
        0x1bc : s16 MagicDefense;
        // magicDefensePower() returns (s32)this
        0x1be : s16 MagicDefensePower;
        // character id; -1 when unassigned
        0x1c4 : s32 cid;
        // PlayerEquipmentSymbol[HAND_TYPE]
        0x1c8 : u8[2][0x1c] EquipmentSymbol;
        // LearningAbilityManager; learningAbility() returns &this
        0x200 : u8[0x30] LearningAbilityManager;

