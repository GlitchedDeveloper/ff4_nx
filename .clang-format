---
AccessModifierOffset: -2
AlignConsecutiveAssignments: true
BasedOnStyle: WebKit
BreakBeforeBraces: Custom

BraceWrapping:
  AfterClass: true
  AfterStruct: true
  AfterEnum: true

IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<windows\.h>'
    Priority: 0
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*'
    Priority: 2
  - Regex: '.*'
    Priority: 3

IndentCaseLabels: true
PointerAlignment: Left
SortIncludes: true
Standard: Cpp11
ColumnLimit: 0

...
